<div class="container">
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#Pretraga">Pretraga</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#Pretraga2">Pretraga uz adresu</a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#Pretraga3">Napredna pretraga</a>
        </li>

    </ul>




    <div class="tab-content">
        <div class="tab-pane fade show active" id="Pretraga">
            <form method="GET" action="/Client/Index">
                <input type="text" name="query" placeholder="Pretraga po imenu">
                <input type="submit" value="Submit">
            </form>
        </div>
        <div class="tab-pane fade" id="Pretraga2">
            <form method="POST" action="/Client/Index">
                <input type="text" name="queryName" placeholder="Pretraga po imenu">
                <input type="text" name="queryAddress" placeholder="Pretraga po adresi">
                <input type="submit" value="Submit">
            </form>
        </div>

        <div class="tab-pane fade" id="Pretraga3">
            <form method="POST" action="/Client/AdvancedSearch">
                <input type="text" name="partQueryName" placeholder="Pretraga po imenu">
                <input type="text" name="partQueryAddress" placeholder="Pretraga po adresi">
                <input type="text" name="partQueryEmail" placeholder="Pretraga po e-mailu">
                <input type="text" name="partQueryCity" placeholder="Pretraga po gradu">
                <input type="submit" value="Submit">
            </form>
        </div>

    </div>
</div>


<div class="container">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th class="col-3">Client</th>
                <th class="col-3">Address</th>
                <th class="col-3">Email</th>
                <th class="col-3">City</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>
                        @Html.ActionLink(@client.FullName, "Details", "Client", routeValues: new { id = client.ID }, htmlAttributes: new { @class = "text-primary", @style = "text-decoration:none;" })
                    </td>
                    <td>@client.Address</td>
                    <td>@client.Email</td>
                    @foreach (var city in Cities)
                                {
                        if (client.CityID == city.ID)
                        {
                            <td>@city.Name</td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>