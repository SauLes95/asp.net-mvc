@model List<Client>

@{
	ViewData["Title"] = "Home Page";
}

<h1>Popis klijenata</h1>
<div style="margin-top: 20px; margin-bottom: 10px;">
	<partial name="_ClientFilter" model="new ClientFilterModel()" />
</div>

<table style="margin-top: 20px;" class="table table-condensed">
	<thead>
		<tr>
			<th>Client</th>
			<th>Address</th>
			<th>Email</th>
			<th>City</th>
			<th></th>
		</tr>
	</thead>
	<tbody id="tbl-clients">
		@foreach (var item in Model)
		{
			<tr onmouseover="lessOpacity(this)" onclick="toggleBold(this)">
				<td>
					<a asp-action="Details" asp-route-id="@item.ID">@item.FullName</a>
				</td>
				<td>@item.Address</td>
				<td>@item.Email</td>
				<td>@item.City?.Name</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-primary">Edit</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@section Scripts {
	<script type="text/javascript">
		function lessOpacity(row) {
			$("#tbl-clients tr").css("opacity", "0.5");
			$(row).css("opacity", "1");
		}

		function toggleBold(row) {
			const $row = $(row);
			const isBold = $row.hasClass("bold-row");
			$row.toggleClass("bold-row", !isBold);
		}

		$(function () {
			$("#tbl-clients tr").css("opacity", "0.5");
		});
	</script>

	<style>
		.bold-row {
			font-weight: bold;
		}
	</style>
}
