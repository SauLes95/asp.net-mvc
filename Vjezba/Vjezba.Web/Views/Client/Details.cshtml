@using Vjezba.Web.Mock;
@model Client;

@{
    ViewData["Title"] = "Details";
    var city = ViewBag.city;
}

<h2>Details</h2>
<h4>Client</h4>
<hr />
<nav style="--bs-breadcrumb-divider: '/';" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="..">Popis klijenata</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
    </ol>
</nav>

@if(Model != null){

    <div class="container">
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">ID</div>
            <div class="col-sm-9">@Model.ID</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Ime i prezime</div>
            <div class="col-sm-9">@Model.FullName</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Email</div>
            <div class="col-sm-9">@Model.Email</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Spol</div>
            <div class="col-sm-9">@Model.Gender</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Adresa</div>
            <div class="col-sm-9">@Model.Address</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Tel.</div>
            <div class="col-sm-9">@Model.PhoneNumber</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 fw-bold">Grad</div>
            <div class="col-sm-9">@city</div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        Neispravan ID
    </div>
}

@Html.ActionLink("Back to list", "Index", "Client", htmlAttributes: new { @class = "text-primary", @style = "text-decoration:none;" })
